          "links": [],
          "title": "Last Flow Timestamp",
          "vizConfig": {
            "group": "stat",
            "kind": "VizConfig",
            "spec": {
              "fieldConfig": {
                "defaults": {
                  "color": {
                    "mode": "thresholds"
                  },
                  "mappings": [
                    {
                      "options": {
                        "<60": {
                          "color": "dark-green",
                          "index": 2,
                          "text": "OK"
                        },
                        ">300": {
                          "color": "dark-red",
                          "index": 0,
                          "text": "FLOW STALLED"
                        }
                      },
                      "type": "value"
                    },
                    {
                      "options": {
                        "from": 60,
                        "result": {
                          "color": "semi-dark-orange",
                          "index": 1,
                          "text": "FLOW DELAYED"
                        },
                        "to": 300
                      },
                      "type": "range"
                    }
                  ],
                  "thresholds": {
                    "mode": "absolute",
                    "steps": [
                      {
                        "color": "dark-green",
                        "value": 0
                      },
                      {
                        "color": "dark-yellow",
                        "value": 60
                      },
                      {
                        "color": "dark-orange",
                        "value": 200
                      },
                      {
                        "color": "dark-red",
                        "value": 300
                      }
                    ]
                  },
                  "unit": "s"
                },
                "overrides": []
              },
